{
  "name": "wallet-portrait",
  "version": "0.1.0",
  "description": "Readable on-chain portrait of an Ethereum address: activity, labeled protocols, and heuristic tags.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wallet-portrait": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "demo": "vite --config vite.config.ts",
    "demo:build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laodeng2313/wallet-portrait.git"
  },
  "keywords": [
    "ethereum",
    "evm",
    "wallet",
    "cli",
    "onchain"
  ],
  "dependencies": {
    "viem": "^2.38.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
