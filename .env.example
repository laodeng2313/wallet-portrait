# Optional. Ethereum JSON-RPC URL. When unset, the CLI tries public endpoints.
# The URL is redacted in portrait output (userinfo and common key query params).
# RPC_URL=https://ethereum.publicnode.com

# Optional. Etherscan API key (v2). When unset, history comes from Blockscout.
# If Etherscan fails, Blockscout is the fallback. If both fail, the portrait
# is still built from RPC balance, nonce, and bytecode.
# ETHERSCAN_API_KEY=
